# EC11 Knob Minimal System: ESP32-S3-DevKitC-1 N16R8 + ST7789 + EC11
CONFIG_BOARD_EC11_KNOB_MINIMAL=y

# Match the contributor-validated ESP32-S3-WROOM-1 N16R8 module.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set

# ESP-IDF 5.5.5's GCC 14 toolchain can ICE in esp_lcd RGB code at -Og even
# though this SPI board does not use RGB. The release/performance build avoids
# that compiler bug and is also the setting used by the supported S3 RGB board.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ec11_knob_minimal.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_ec11_knob_minimal.csv"

# PR #6 reference EC11 wiring: A=13, B=14, push=46, common/GND active-low.
CONFIG_INPUT_ROTARY_ENCODER=y
CONFIG_INPUT_ROTARY_GPIO_A=13
CONFIG_INPUT_ROTARY_GPIO_B=14
CONFIG_INPUT_ROTARY_GPIO_BUTTON=46
CONFIG_INPUT_ROTARY_COUNTS_PER_DETENT=4
CONFIG_INPUT_ROTARY_PHASE_PULLUPS=y
CONFIG_INPUT_ROTARY_BUTTON_ACTIVE_LOW=y
CONFIG_INPUT_ROTARY_BUTTON_DEBOUNCE_MS=30
CONFIG_INPUT_ROTARY_GLITCH_FILTER_NS=1000
