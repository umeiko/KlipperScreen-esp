# 板型：Guition ESP32-4848S040（ESP32-S3，4.0" 480x480 ST7701S RGB + GT911 电容触摸）
# 覆盖 ESP32-4848S040C_I / ESP32-4848S040C_I_Y_1 / ESP32-4848S040C_I_Y_3
CONFIG_BOARD_ESP32S3_4848S040=y

# ESP32-S3-WROOM-1 N16R8：Flash 16MB 80MHz QIO，8MB Octal PSRAM 80MHz
# RGB 接口双帧缓冲（2 x 480x480x2B = 900KB）放 PSRAM
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# RGB 屏 DMA 直接从 PSRAM 整帧缓冲取数
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# 不开 XIP：与 JC8048 / SenseCAP 排障结论对齐（XIP 让代码取指走 PSRAM，与 LCD EDMA 争抢 MSPI）
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set

# 复用 JC8048 16MB flash 分区表（factory 8.5MB 放全表 28/32 不压缩字库，其余 ~7.4MB 给 littlefs）
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_jc8048w550.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_jc8048w550.csv"

# LVGL 渲染周期 15ms：rgb44 flush_cb 阻塞等 vsync 换页，帧节奏锁到面板 vsync（~42fps）
CONFIG_LV_DEF_REFR_PERIOD=15

# -O2：同 JC8048 / SenseCAP，RGB 屏滑动整页渲染必须压进帧预算
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# D-cache line 保持 32B 默认（JC8048 已实测 64B 证伪）

# gcode 切片缩略图 PNG 解码 + Moonraker 摄像头 JPEG 解码（仅 PSRAM 板启用）
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_USE_TJPGD=y
# CONFIG_JD_USE_ROM is not set
CONFIG_JD_FASTDECODE_TABLE=y
