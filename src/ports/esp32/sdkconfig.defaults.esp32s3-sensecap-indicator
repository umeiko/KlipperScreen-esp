# 板型：Seeed SenseCAP Indicator（ESP32-S3，4" 480x480 ST7701S RGB + FT5x06 电容触摸）
CONFIG_BOARD_SENSECAP_INDICATOR=y

# ESP32-S3-WROOM-1 N8R8：Flash 8MB 80MHz QIO，8MB Octal PSRAM 80MHz
# RGB 接口整帧缓冲（480x480x2B = 450KB）必须放 PSRAM
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# RGB 屏 DMA 直接从 PSRAM 整帧缓冲取数
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# 不开 XIP：与 JC8048 排障结论对齐（XIP 让代码取指走 PSRAM，与 LCD EDMA 争抢 MSPI）
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set

# 8MB flash 专用分区表（factory 4MB，28/32 只链最小子集）
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_sensecap_indicator.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_sensecap_indicator.csv"

# LVGL 渲染周期 15ms：rgb44 flush_cb 阻塞等 vsync 换页，帧节奏锁到面板 vsync。
# 默认 33ms 会让内容更新率与 vsync 错拍 → 滑动帧间隔忽长忽短（JC8048 排障结论）
CONFIG_LV_DEF_REFR_PERIOD=15

# -O2：同 JC8048，RGB 屏滑动整页渲染必须压进帧预算
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# D-cache line 保持 32B 默认（JC8048 已实测 64B 证伪）
