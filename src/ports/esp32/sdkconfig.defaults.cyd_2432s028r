# 板型：CYD 2432S028R（ESP32，2.8" 320x240 ILI9341 SPI + XPT2046 电阻触摸）
CONFIG_BOARD_CYD_2432S028R=y

# Flash 4MB 80MHz QIO，主频 240MHz（CYD 标配 4MB）
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y

# 外接 EC11 旋转编码器：A=IO35 B=IO22 SW=IO27（对 GND，低电平有效）
# 注意 IO35 无内部上拉，裸编码器的 A 相需外接上拉电阻（~10k 到 3V3）
CONFIG_INPUT_ROTARY_ENCODER=y
CONFIG_INPUT_ROTARY_GPIO_A=35
CONFIG_INPUT_ROTARY_GPIO_B=22
CONFIG_INPUT_ROTARY_GPIO_BUTTON=27
CONFIG_INPUT_ROTARY_COUNTS_PER_DETENT=4
CONFIG_INPUT_ROTARY_PHASE_PULLUPS=y
CONFIG_INPUT_ROTARY_BUTTON_ACTIVE_LOW=y
CONFIG_INPUT_ROTARY_BUTTON_DEBOUNCE_MS=30
CONFIG_INPUT_ROTARY_GLITCH_FILTER_NS=1000
# 无 PSRAM 板：收缩 mbedTLS 记录缓冲，给 Bambu TLS 让出堆（默认 16384 太奢侈）
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
