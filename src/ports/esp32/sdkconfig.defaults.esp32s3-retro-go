# esp32s3-retro-go: Chaeng retro-go ESP32-S3 掌机（T320-S3），ST7789 + GPIO 按键
CONFIG_BOARD_ESP32S3_RETRO_GO=y

# 上游 retro-go t320-s3 目标同款模组：ESP32-S3 N16R8（16MB flash + 8MB Octal PSRAM）
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set

# ESP-IDF 5.5.5's GCC 14 toolchain can ICE in esp_lcd RGB code at -Og even
# though this SPI board does not use RGB. The release/performance build avoids
# that compiler bug and is also the setting used by the supported S3 RGB board.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_esp32s3-retro-go.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_esp32s3-retro-go.csv"

# 无旋转编码器、无触摸：导航全部走板载 GPIO 按键（bsp_gpio_buttons 后端，
# 键表在 src/bsp/esp32/bsp_esp32s3_retro_go.c，不占用 Kconfig 输入配置）。
