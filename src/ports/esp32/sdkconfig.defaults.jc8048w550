# 板型：JC8048W550（ESP32-S3，5" 800x480 ST7262 RGB + GT911 电容触摸）
CONFIG_BOARD_JC8048W550=y

# ESP32-S3-WROOM-1 N16R8：Flash 16MB 80MHz QIO，8MB Octal PSRAM 80MHz
# RGB 接口整帧缓冲（800x480x2B = 768KB）必须放 PSRAM
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# RGB 屏 DMA 直接从 PSRAM 整帧缓冲取数
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# 不开 XIP：与厂商 Arduino demo 对齐（XIP 让代码取指走 PSRAM，与 LCD EDMA 争抢 MSPI）
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set

# 16MB flash 专用分区表（factory 8.5MB 放全表字库，28/32 不压缩）
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_jc8048w550.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_jc8048w550.csv"

# LVGL 渲染周期 15ms：rgb44 flush_cb 阻塞等 vsync 换页，实际帧节奏锁到面板 39fps。
# 默认 33ms 会让内容更新率卡在 30Hz，与 39Hz vsync 错拍 → 滑动帧间隔忽长忽短（轻微抖动）
CONFIG_LV_DEF_REFR_PERIOD=15

# -O2：-Og 下滑动整页渲染 ~50ms/帧（远超 25.6ms 帧预算），实测掉到 ~17fps 且帧间隔不均。
# 仅本板开启（CYD 4MB flash 分区余量仅 9%，-O2 体积风险大）
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# D-cache line 64B 已实测证伪（2026-09-08）：静止自抽+滑动花屏加剧，保持 32B 默认
