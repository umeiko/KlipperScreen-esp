# 板型：立创实战派 ESP32-S3（esp32s3-JLC-SZP，2.0" 320x240 ST7789 SPI + FT6336 电容触摸）
CONFIG_BOARD_ESP32S3_JLC_SZP=y

# ESP32-S3-WROOM-1 N16R8：Flash 16MB 80MHz QIO，8MB Octal PSRAM 80MHz
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set

# 同 esp32s3-st7789-320_240-ec11：ESP-IDF 5.5.5 的 GCC14 在 -Og 下编译 esp_lcd RGB 代码会 ICE，
# 性能档避开该编译器 bug，也是 S3 板型的统一设置
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 16MB flash 分区表（与 esp32s3-st7789-320_240-ec11 同布局：factory ~10MB + 6MB littlefs）
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_esp32s3_jlc_szp.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_esp32s3_jlc_szp.csv"
