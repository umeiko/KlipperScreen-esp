# 板型：CYD 2432S028R-PLUS（ESP32，2.8" 320x240 ST7789 SPI + XPT2046 电阻触摸，引脚与原版 CYD 相同）
CONFIG_BOARD_CYD_2432S028R_PLUS=y

# Flash 4MB 80MHz QIO，主频 240MHz（CYD 标配 4MB）
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y

# 外接 EC11 旋转编码器：A=IO23 B=IO19 SW=IO18（对 GND，低电平有效，CN3 排针直出）
# 三脚均有内部上拉，裸编码器直接接；注意这三个脚与板载 SD 卡槽共用，不能同时用 SD
CONFIG_INPUT_ROTARY_ENCODER=y
CONFIG_INPUT_ROTARY_GPIO_A=23
CONFIG_INPUT_ROTARY_GPIO_B=19
CONFIG_INPUT_ROTARY_GPIO_BUTTON=18
CONFIG_INPUT_ROTARY_COUNTS_PER_DETENT=4
CONFIG_INPUT_ROTARY_PHASE_PULLUPS=y
CONFIG_INPUT_ROTARY_BUTTON_ACTIVE_LOW=y
CONFIG_INPUT_ROTARY_BUTTON_DEBOUNCE_MS=30
CONFIG_INPUT_ROTARY_GLITCH_FILTER_NS=1000
# 无 PSRAM 板：收缩 mbedTLS 记录缓冲，给 Bambu TLS 让出堆（默认 16384 太奢侈）
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
