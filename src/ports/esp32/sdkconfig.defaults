# ESP-IDF v5.5.5 / LVGL v9.3 基础配置（所有板型共用）
# 板型相关项（芯片/Flash/PSRAM/板型选择）在 sdkconfig.defaults.<board>，
# 由 tools/build-esp32.sh 按板型拼入 SDKCONFIG_DEFAULTS。

# LVGL：16bit 色深，启用大字号
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# LVGL 用 CLIB malloc（ESP-IDF 系统堆），不用内置 64KB TLSF 池：
# 大控件透明度/缩放动画需要大尺寸图层缓冲（数字键盘卡片约 99KB），
# 内置池分配失败会让 draw dispatch 无限重试，lvgl 任务卡死触发看门狗
CONFIG_LV_USE_CLIB_MALLOC=y

# FreeRTOS tick 1000Hz（动画帧时钟精度）
CONFIG_FREERTOS_HZ=1000

# 自定义分区表（factory 2MB，WiFi 固件超 1MB 默认分区）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# CJK 全表字体（GB2312 6840 字）走 RLE 压缩，否则 flash 放不下
CONFIG_LV_USE_FONT_COMPRESSED=y

# 28/32 全表字库 glyph 索引超 20bit，需要大字体格式
CONFIG_LV_FONT_FMT_TXT_LARGE=y
