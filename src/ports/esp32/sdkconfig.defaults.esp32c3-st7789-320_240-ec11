# 板型：esp32c3-st7789-320_240-ec11（ESP32-C3 + 240x320 ST7789 横屏 + EC11，
# 合宙 CORE ESP32-C3 USB 直连版 / ESP32-C3 Super Mini 同一接线、同一固件）
CONFIG_BOARD_ESP32C3_ST7789_EC11=y

# Flash 4MB 80MHz **DIO**：合宙 CORE 板 flash 为两线接法（IO12/13 没接 flash），
# QIO 点不亮；DIO 两块目标板通吃。C3 主频固定 160MHz，无需配置。
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# C3 的 4MB flash 不能扩 app 分区而不移动 LittleFS（会导致升级丢配置）。
# 相比旧 canonical 的 -Og，-Os 同时缩小固件并保持适合发布的优化级别。
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# 控制台走 USB-Serial-JTAG（GPIO18/19）：USB 直连版没有 CH340，
# 烧录和串口 CLI 都走 Type-C 直连
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# EC11 旋转编码器：A=IO0 B=IO1 SW=IO10（C3 全部 GPIO 有内部上拉，无需外接电阻；
# C3 无 PCNT 外设，bsp_rotary_encoder 自动走 2ms esp_timer 轮询解码后端，
# GLITCH_FILTER_NS 在该后端忽略，保留配置仅为与其他板型对齐）
CONFIG_INPUT_ROTARY_ENCODER=y
CONFIG_INPUT_ROTARY_GPIO_A=0
CONFIG_INPUT_ROTARY_GPIO_B=1
CONFIG_INPUT_ROTARY_GPIO_BUTTON=10
CONFIG_INPUT_ROTARY_COUNTS_PER_DETENT=4
CONFIG_INPUT_ROTARY_PHASE_PULLUPS=y
CONFIG_INPUT_ROTARY_BUTTON_ACTIVE_LOW=y
CONFIG_INPUT_ROTARY_BUTTON_DEBOUNCE_MS=30
CONFIG_INPUT_ROTARY_GLITCH_FILTER_NS=1000

# 无 PSRAM 且 RAM 更紧（400KB）：收缩 mbedTLS 记录缓冲（默认 16384 太奢侈）
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
