# 板型：ESP32-32E 3.5" E32R35T（ESP32，480x320 ST7796 SPI + XPT2046 电阻触摸）
CONFIG_BOARD_E32R35T=y

# Flash 4MB 80MHz QIO，主频 240MHz（ESP32-32E 标配 4MB）
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
# 无 PSRAM 板：收缩 mbedTLS 记录缓冲，给 Bambu TLS 让出堆（默认 16384 太奢侈）
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
