# ESP-IDF / 各 port 构建产物
src/ports/*/build*/
src/ports/esp32/sdkconfig
src/ports/esp32/sdkconfig.old
src/ports/esp32/managed_components/
src/ports/esp32/dependencies.lock

# 根目录早期构建残留（真实工程在 src/ports/esp32）
/managed_components/
/sdkconfig

# host 端单元测试产物（tools/test-stream-parser.sh）
/build-tests/
/dependencies.lock

# 截图产物
*.bmp
*.png
!docs/**/*.png

# 第三方与工具链（不入库，按文档拉取）
third_party/lvgl/
third_party/SDL2/
third_party/cjson/
third_party/mbedtls/
third_party/cacert.pem
.reff/
tools/dl/
tools/msys64/
tools/fontgen/node_modules/
tools/icongen/node_modules/
tools/icongen/.venv/

# Android 端口：gradle 产物、本机 SDK 配置、fetch-android-deps.sh 拷入的 SDL 胶水层
src/ports/android/.gradle/
src/ports/android/app/build/
src/ports/android/app/.cxx/
src/ports/android/local.properties
src/ports/android/app/src/main/java/org/
# 启动器图标是入库资产（tools/android-launcher-icon.py 生成），豁免上方 *.png 规则
!src/ports/android/**/*.png

# 临时
tmp/
__pycache__/
*.py[cod]

# MkDocs 本地构建产物（CI 里重新构建）
/site/

# 本地打包产物（CI/Release 会重新生成）
/dist/

# desktop 后端运行时产生的本机配置（勿入库）
src/ports/desktop/*.conf
