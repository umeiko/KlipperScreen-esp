[Unit]
Description=Klipper Remote Display
StartLimitIntervalSec=0
# Make sure we are started after logins are permitted. If Plymouth is
# used, we want to start when it is on its way out.
After=systemd-user-sessions.service plymouth-quit-wait.service
# On systems without virtual consoles, do not start.
ConditionPathExists=/dev/tty0
# D-Bus is necessary for contacting logind, which is required.
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
After=moonraker.service

[Service]
Type=simple
Restart=always
RestartSec=2
User=KR_USER
SupplementaryGroups=tty video input render
WorkingDirectory=KR_DIR
Environment=BACKEND=KR_BACKEND
# TTYPath 会把 stdout/stderr 默认打到 tty7；显式收进 journal，
# 方便 systemctl/journalctl 排查（Klipper 上位机上 start 脚本还会落
# printer_data/logs/KlipperScreen-esp.log 供 fluidd/mainsail 下载）。
StandardOutput=journal
StandardError=journal
ExecStart=KR_DIR/KlipperScreen-esp-start.sh
ExecStartPost=+chvt 7

# Log this user with utmp, letting it show up with commands 'w' and
# 'who'. This is needed since we replace (a)getty.
UtmpIdentifier=tty7
UtmpMode=user
# Create a PAM session to run pam-systemd, which creates /var/run/$UID
PAMName=%u
# A virtual terminal is needed.
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
